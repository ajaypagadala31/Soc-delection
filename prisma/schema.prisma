generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  isActive      Boolean    @default(true)
  isMfaEnabled  Boolean    @default(false)
  mfaSecret     String?
  mfaBackupCodes String[] @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?

  roles         UserRole[]
  auditLogs     AuditLog[]
  assignedAlerts    Alert[]    @relation("AssignedAlerts")
  assignedIncidents Incident[] @relation("AssignedIncidents")
  createdIncidents  Incident[] @relation("CreatedIncidents")
  apiKeys       ApiKey[]
  wsSessions    WebsocketSession[]
  passwordResets  PasswordReset[]
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  level       Int        @default(0)  // For ordering: 1=Viewer, 2=Analyst, 3=Manager, 4=SuperAdmin
  createdAt   DateTime   @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String     @id @default(uuid())
  resource    String
  action      String
  description String?

  roles       RolePermission[]
}

model UserRole {
  user   User  @relation(fields: [userId], references: [id])
  userId String

  role   Role  @relation(fields: [roleId], references: [id])
  roleId String

  @@id([userId, roleId])
}

model RolePermission {
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String

  @@id([roleId, permissionId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  details      Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// Password Reset Tokens
model PasswordReset {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  used       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

// Detection Rules
model DetectionRule {
  id               String   @id @default(uuid())
  name             String
  description      String?
  ruleType         String
  severity         String
  mitreAttackTechnique String?
  mitreAttackTactic    String?
  mitreAttackTactics   String[] @default([])
  condition          Json
  response           Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  firedCount         Int      @default(0)
  lastFiredAt        DateTime?

  createdBy          String?
  createdByUser      User?   @relation(fields: [createdBy], references: [id])
  alerts             Alert[]
}

// Alerts
model Alert {
  id           String   @id @default(uuid())
  ruleId       String?
  title        String
  description  String?
  severity     String
  status       String   @default("open")
  source       String?
  sourceId     String?
  alertData    Json?
  assignedTo   String?
  createdAt    DateTime @default(now())
  acknowledgedAt DateTime?
  closedAt     DateTime?
  notes        Json[]   @default([])

  rule       DetectionRule @relation(fields: [ruleId], references: [id])
  assignedToUser User?      @relation("AssignedAlerts", fields: [assignedTo], references: [id])
  incidents    IncidentAlert[]
}

// Incidents
model Incident {
  id               String   @id @default(uuid())
  title            String
  description      String?
  severity         String
  status           String   @default("open")
  priority         String?
  category         String?
  mitreAttackTechnique String?
  mitreAttackTactics   String[] @default([])
  relatedAlerts    String[]   @default([])
  assignedTo       String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?
  timeline         Json[]   @default([])
  notes            Json[]   @default([])

  assignedToUser   User?      @relation("AssignedIncidents", fields: [assignedTo], references: [id])
  createdByUser    User?      @relation("CreatedIncidents", fields: [createdBy], references: [id])
}

// Junction table for Alert-Incident relationship
model IncidentAlert {
  incident   Incident @relation(fields: [incidentId], references: [id])
  incidentId String

  alert   Alert @relation(fields: [alertId], references: [id])
  alertId String

  @@id([incidentId, alertId])
}

// Wazuh Integration
model WazuhAgent {
  id           String   @id @default(uuid())
  agentId      Int      @unique
  name         String
  ipAddress    String?
  os           String?
  version      String?
  status       String   @default("active")
  lastSeen     DateTime?
  registeredAt DateTime @default(now())
  lastApiSync  DateTime?
  tags         String[] @default([])

  wazuhAlerts WazuhAlert[]
}

model WazuhAlert {
  id           String   @id @default(uuid())
  wazuhAgentId Int
  alertId      String
  ruleId       Int?
  level        Int?
  description  String?
  fullLog      String?
  rawAlert     Json?
  receivedAt   DateTime @default(now())
  ingestedAt   DateTime @default(now())
  processed    Boolean  @default(false)

  wazuhAgent WazuhAgent @relation(fields: [wazuhAgentId], references: [agentId])
}

// API Keys
model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  name        String?
  keyHash     String
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?

  user User @relation(fields: [userId], references: [id])
}

// WebSocket sessions
model WebsocketSession {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String   @unique
  socketId    String?
  connectedAt DateTime @default(now())
  disconnectedAt DateTime?
  ipAddress   String?

  user User @relation(fields: [userId], references: [id])
}

// IOC (Indicator of Compromise) Management
model IOC {
  id          String   @id @default(uuid())
  type        String   // ip, domain, hash, url, email
  value       String   @unique
  description String?
  severity    String   @default("medium")
  confidence  Int      @default(50)
  source      String?
  createdAt   DateTime @default(now())
  createdAtBy String?
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  tags        String[] @default([])

  createdByUser User? @relation(fields: [createdAtBy], references: [id])
}

// Threat Intelligence
model ThreatIntel {
  id          String   @id @default(uuid())
  indicatorId String?
  threatName  String
  threatType  String   // malware, apt, ransomware, etc.
  description String?
  aliases     String[] @default([])
  confidence  Int      @default(50)
  rating      String?  // cold, cautious, likely, definitely
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  tags        String[] @default([])

  indicator   IOC?     @relation(fields: [indicatorId], references: [id])
}

// Scheduled Tasks / Jobs
model ScheduledJob {
  id          String   @id @default(uuid())
  name        String   @unique
  command     String
  schedule    String   // cron expression
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastResult  Json?
  lastError   String?
}

// Notification Templates
model NotificationTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String?
  body        String   // can be HTML
  channel     String   // email, slack, webhook
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}