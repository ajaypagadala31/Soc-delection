# Database Configuration
DATABASE_URL="postgresql://sentinelx:secure_password_change_me@localhost:5432/sentinelx?schema=public"
POSTGRES_USER="sentinelx"
POSTGRES_PASSWORD="secure_password_change_me"
POSTGRES_DB="sentinelx"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API Configuration
PORT=3001
NODE_ENV="development"

# Wazuh Integration
WAZUH_BASE_URL="https://localhost:55000"
WAZUH_API_USER="admin"
WAZUH_API_PASSWORD="admin"
WAZUH_API_AUTH_TOKEN=""

# Security Headers
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MFA Configuration
MFA_ISSUER="SENTINEL-X"
MFA_DIGITS=6
MFA_PERIOD=30

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Session Configuration
SESSION_EXPIRY_MINUTES=30

# File Upload Limits
MAX_FILE_SIZE=10485760

# Audit Logging
AUDIT_LOG_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24