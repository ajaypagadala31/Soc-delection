{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ES2020"],
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxNoImportSource": false,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "module": "ESNext",
    "moduleNoHoisting": false,
    "moduleResolution": "node",
    "lib": ["dom", "es2020"],
    "typeRoots": ["node_modules/@types"],
    "types": ["vite/client", "vite/client", "vite/client/auto-import"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.js", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "build", "node_modules"]
}